  <folder name="Motivation" id="id-6e1ef5d1b81f4ace828699418a31e05b" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Gerente de Operações" id="id-2138effe073947cba407bddbaad18b14"/>
    <element xsi:type="archimate:Stakeholder" name="Operadores de Galpão" id="id-a13197b50b664dc8be436e418e25e820"/>
    <element xsi:type="archimate:Stakeholder" name="Diretores Regionais" id="id-b5680f64fa804f19bec4df372f145f6e"/>
