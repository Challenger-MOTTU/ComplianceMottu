    <element xsi:type="archimate:BusinessProcess" name="Receber Moto" id="id-6d351817569b46319b99e6de88381685"/>
    <element xsi:type="archimate:BusinessProcess" name="Mapear Moto" id="id-549ad54a7b074c6590279afe8630b2a9"/>
    <element xsi:type="archimate:BusinessProcess" name="Registrar Avarias" id="id-038b07ec54954a90a31dcfae7e57eac1"/>
    <element xsi:type="archimate:BusinessProcess" name="Localizar e Liberar Moto" id="id-d20a5a672abe43e6ac11f6848ea361f1"/>
    <element xsi:type="archimate:BusinessProcess" name="Consultar Histórico" id="id-9073c504dc47413b95c16fdec05130a9"/>
    <element xsi:type="archimate:BusinessFunction" name="Cadastro de entrada" id="id-82e7339062624510835003e536316baf"/>
    <element xsi:type="archimate:BusinessFunction" name="Identificação visual" id="id-4eeabf9f131f4c0eba7c99e49b2511d4"/>
    <element xsi:type="archimate:BusinessFunction" name="Conferência de posição" id="id-c4a3f4918ea9452886237a8dd536dad9"/>
    <element xsi:type="archimate:BusinessFunction" name="Padronização de etiquetas de avaria" id="id-96b5295a6a844e0b84b22a0306b734a6"/>
    <element xsi:type="archimate:BusinessService" name="Serviço de Localização de Motos" id="id-815ea1498dd24e38b2421bd5035a45be"/>
    <element xsi:type="archimate:BusinessService" name="Serviço de Registro de Avarias" id="id-cb9848f6ba254f23abf4adc2c63d3320"/>
    <element xsi:type="archimate:BusinessService" name="Serviço de Auditoria e Histórico" id="id-62a4f75f3b9f4ef99ae08c26a192d80e"/>
    <element xsi:type="archimate:BusinessProcess" name="Recebimento da moto no portão de entrada da filial" id="id-37d597e779be400ebbbb81b685b8b139"/>
    <element xsi:type="archimate:BusinessProcess" name="O operador realiza o login no sistema via desktop, tablet ou celular." id="id-860a66222f3e432fb8bb5188ae8420a1"/>
    <element xsi:type="archimate:BusinessProcess" name="Preenchimento dos campos obrigatórios: Placa da moto, Modelo, CPF/CNPJ do responsável pela entrega, Nome do condutor, Contrato de origem, Horário estimado de entrega" id="id-2ce992fdcf1e4e6580264b62639a56de"/>
    <element xsi:type="archimate:BusinessProcess" name="O sistema valida a placa por OCR (caso tenha câmera no ponto de entrada)." id="id-6e819e3030bf4b3e9f37ffff13d33344"/>
    <element xsi:type="archimate:BusinessProcess" name="Geração automática de um ID único da movimentação." id="id-09a21618b874434d976d3dc99d321c33"/>
    <element xsi:type="archimate:BusinessProcess" name="Registro é salvo no banco Oracle, iniciando o histórico da moto." id="id-244506455c58481b8820d0cb9240aa89"/>
    <element xsi:type="archimate:BusinessProcess" name="A moto ainda não possui uma posição física no mapa do pátio neste momento." id="id-993e0b96f31e4ad3ba4129a3e0917843"/>
    <element xsi:type="archimate:BusinessProcess" name="Após o estacionamento da moto, uma câmera posicionada estrategicamente capta imagens." id="id-f5a837e4bd1d439a9c81f356e09b4c19"/>
    <element xsi:type="archimate:BusinessProcess" name="O sistema aplica visão computacional para: Detectar a placa (via OCR), Reconhecer a posição física da moto no layout do pátio, Associar a imagem da moto ao seu ID no sistema." id="id-176e7fd59a9b440192d28a9eb6414dfa"/>
    <element xsi:type="archimate:BusinessProcess" name="O algoritmo converte a posição da imagem em: Coordenadas (ex: x:450, y:320), Zona lógica (ex: “Corredor C – Bloco 2”)." id="id-ed352c8a9f4148f3b9d15dc69b447b3f"/>
    <element xsi:type="archimate:BusinessProcess" name="O sistema atualiza a localização atual no mapa digital em tempo real." id="id-88cd83b1dcac4294868909b4c4295063"/>
    <element xsi:type="archimate:BusinessProcess" name="Se a câmera não identificar com precisão, o sistema marca como “posição a confirmar”." id="id-7bcd171b04c8495a8b04088209326c54"/>
    <element xsi:type="archimate:BusinessProcess" name="Acessa a tela “Mapa do Pátio” no sistema." id="id-355c922c2fc041928f62d39a12e2e282"/>
    <element xsi:type="archimate:BusinessProcess" name="Pesquisa pela placa ou ID da movimentação." id="id-b697c767272d4e8e8cf77c71dac22ed5"/>
    <element xsi:type="archimate:BusinessProcess" name="O sistema mostra: A última posição registrada (bloco e corredor) e foto mais recente captada da moto" id="id-d8abe1f40740415c911cd21fe6071245"/>
    <element xsi:type="archimate:BusinessProcess" name="Verifica fisicamente no pátio se a moto está ali." id="id-f4c13a38e4dc4835b8f32509d32b5299"/>
    <element xsi:type="archimate:BusinessProcess" name="Se estiver correta: Confirma a posição com um clique e o sistema registra a conferência com carimbo de data/hora" id="id-f19377b6114647f089bd27731fd991aa"/>
    <element xsi:type="archimate:BusinessProcess" name="Se estiver incorreta: Atualiza a nova posição manualmente e o sistema registra uma ocorrência de deslocamento" id="id-e4c5f87859684df98779bafa2cfea940"/>
    <element xsi:type="archimate:BusinessProcess" name="O operador inspeciona visualmente a moto no momento da entrada." id="id-fb2c91c7ca814931ae7b42099c149e4d"/>
    <element xsi:type="archimate:BusinessProcess" name="Ao encontrar uma avaria: Aplica uma etiqueta colorida padronizada no local da avaria: Vermelha: Dano grave, Amarela: Dano moderado, Azul: Dano superficial." id="id-2ad99d26326c4a91946251c4213b5c75"/>
    <element xsi:type="archimate:BusinessProcess" name="No sistema, acessa a tela “Registrar Avaria”: Seleciona o tipo de avaria em uma lista padronizada (ex: risco, amassado, quebra), Faz upload de 1 ou mais fotos da avaria, Associa à localização (ex: tanque, farol, lateral esquerda)." id="id-f1351ae285bf49a1b957cd402e66b3f6"/>
    <element xsi:type="archimate:BusinessProcess" name="O sistema salva esse registro no histórico da moto." id="id-2ab45d967aed41879a5aa31c0c852c27"/>
    <element xsi:type="archimate:BusinessProcess" name="Em caso de reincidência (mesma avaria em outra visita), o sistema gera uma alerta de recorrência." id="id-aee853c65266454e99e1fd314fd7fc55"/>
    <element xsi:type="archimate:BusinessRole" name="Cadastro da Motos" id="id-5e8a23c4e18844e1972c0f79f4222bcf"/>
  </folder>
